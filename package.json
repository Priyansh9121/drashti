{
  "name": "drashti",
  "productName": "Drashti",
  "version": "1.0.0-alpha.0",
  "description": "Presentation software for BAPS mandirs",
  "private": true,
  "license": "UNLICENSED",
  "author": "Drashti",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.e2e.json",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/vitest-electron.mjs run",
    "test:watch": "node scripts/vitest-electron.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "test:audit": "node tools/audit/test/run-tests.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "test:smoke": "electron-vite build && playwright test tests/e2e/smoke.spec.ts",
    "test:perf": "electron-vite build && playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.49.0",
    "prettier": "^3.9.9",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
